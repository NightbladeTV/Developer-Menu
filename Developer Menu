-- Logic
local function switchTab(selected)
	if selected == "Player" then
		playerContent.Visible = true
		miscContent.Visible = false
		playerTab.BackgroundColor3 = Color3.fromRGB(50,50,50)
		miscTab.BackgroundColor3 = Color3.fromRGB(40,40,40)
	else
		playerContent.Visible = false
		miscContent.Visible = true
		playerTab.BackgroundColor3 = Color3.fromRGB(40,40,40)
		miscTab.BackgroundColor3 = Color3.fromRGB(50,50,50)
	end
end

playerTab.MouseButton1Click:Connect(function() switchTab("Player") end)
miscTab.MouseButton1Click:Connect(function() switchTab("Misc") end)

setSpeed.MouseButton1Click:Connect(function()
	local char = player.Character or player.CharacterAdded:Wait()
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local speed = tonumber(speedBox.Text)
		if speed then humanoid.WalkSpeed = speed end
	end
end)

setJump.MouseButton1Click:Connect(function()
	local char = player.Character or player.CharacterAdded:Wait()
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local jump = tonumber(jumpBox.Text)
		if jump then humanoid.JumpPower = jump end
	end
end)

antiBtn.MouseButton1Click:Connect(function()
	antiAFK = not antiAFK
	antiBtn.Text = antiAFK and "Anti-AFK: ON" or "Anti-AFK: OFF"
	antiBtn.BackgroundColor3 = antiAFK and Color3.fromRGB(60,120,60) or Color3.fromRGB(50,50,50)
end)

