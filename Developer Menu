local function switch(tab)
	if tab=="player" then
		playerPage.Visible=true
		miscPage.Visible=false
		playerTab.BackgroundColor3=Color3.fromRGB(60,60,60)
		miscTab.BackgroundColor3=Color3.fromRGB(40,40,40)
	else
		playerPage.Visible=false
		miscPage.Visible=true
		playerTab.BackgroundColor3=Color3.fromRGB(40,40,40)
		miscTab.BackgroundColor3=Color3.fromRGB(60,60,60)
	end
end

playerTab.MouseButton1Click:Connect(function() switch("player") end)
miscTab.MouseButton1Click:Connect(function() switch("misc") end)

